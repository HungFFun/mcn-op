# ---------------------------------------------------------------------------
# Credentials are read at runtime from these files (create them yourself):
#   ~/.claude/secrets/clickhouse.env       ClickHouse (payout + warehouse tasks)
#   ~/.claude/secrets/telegram_payout.env  payout bot   (payout/ runner)
#   ~/.claude/secrets/telegram_recap.env   recap bot    (MCN report / leave-watch / daily-recap)
#
# You can also drop any of these into <project>/.env to override locally.
# Real shell environment variables take precedence over every file.
#
# The payout runner queries the  tevi_fiat  database; the MCN / recap tasks
# query  tevi_warehouse  (fully-qualified table names, same ClickHouse server).
# ---------------------------------------------------------------------------

# --- ClickHouse (fill these in) --------------------------------------------
CLICKHOUSE_HOST=172.16.0.64
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_DATABASE=tevi_fiat
CLICKHOUSE_SECURE=false

# --- Payout bot (only if NOT reusing telegram_payout.env) ------------------
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID_ID=-4609230789
# TELEGRAM_CHAT_ID_PH=-5293108578
# TELEGRAM_MENTION=@Femirastar
# TELEGRAM_MENTION_PH=@imnotyourhiiro

# --- Recap bot (@mekoo_ops_reporter_bot) — REQUIRED for the tasks/ modules --
# Put this in ~/.claude/secrets/telegram_recap.env, or here:
TELEGRAM_RECAP_BOT_TOKEN=CHANGE_ME
# Group routing (defaults match the original scheduled tasks — override only if changed):
# TELEGRAM_CHAT_MEKOO=-1003553250473     # MCN daily report + leave-watch
# TELEGRAM_CHAT_RECAP_ID=-4609230789     # daily-recap Indonesia group
# TELEGRAM_CHAT_RECAP_PH=-5293108578     # daily-recap Philippines group
# TELEGRAM_LEAVE_CC=@banned_tv1          # cc handle on leave-watch alerts

# --- Control bot (remote control via Telegram: schedule / run / logs) -------
# Its own bot from @BotFather (recommended). If unset, reuses the recap bot token.
# TELEGRAM_CONTROL_BOT_TOKEN=123456:ABC...
# Only these chat ids may issue commands (comma-separated). Leave empty and DM
# the bot /start once — it replies with your chat id to put here.
# TELEGRAM_CONTROL_CHAT_IDS=123456789,-1002222

# --- Business constants (rarely change) ------------------------------------
# MEKOO_MCN_ID=0edb1271-3db6-4f70-a84d-58b1029bad40
# AGENCY_ID_ID=1711465765
# AGENCY_ID_PH=3635488650

# Inviter aliases counted in the MCN daily report (Telegram user ids).
# MCN_ALIAS_INDO=1658892427              # @banned_tv1
# MCN_ALIAS_CS=4224425199                # @Femirastar
